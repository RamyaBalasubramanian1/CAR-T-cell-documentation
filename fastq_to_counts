#!/bin/bash
#SBATCH --job-name=humann4
#SBATCH --output=human_parallel.out
#SBATCH --error=human_parallel.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=400G
#SBATCH --time=5-00:00:00
#SBATCH --partition=cpu2025
#SBATCH --array=1-31%4
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=ramya.balasubramania@ucalgary.ca

set -euo pipefail

source /global/software/conda/miniforge3/etc/profile.d/conda.sh
conda activate biobakery4

INPUT_DIR="/work/mccoy_lab/ramya_pd/larissa_gut_microbiota_WGS/hostile_cleaned_run_2"
OUTPUT_DIR="${INPUT_DIR}/humann4_results"

NUCLEOTIDE_DB="/work/mccoy_lab/ramya_pd/databases/humann4/chocophlan"
PROTEIN_DB="/work/mccoy_lab/ramya_pd/databases/humann4/uniref"

BOWTIE2_DB="/work/mccoy_lab/ramya_pd/databases/metaphlan/vOct22"
METAPHLAN_INDEX="mpa_vOct22_CHOCOPhlAnSGB_202403"

METAPHLAN_BIN="/home/ramya.balasubramania/.conda/envs/metaphlan411_env/bin"

mkdir -p "${OUTPUT_DIR}/combined_reads" "${OUTPUT_DIR}/results"

mapfile -t R1_FILES < <(
    find "$INPUT_DIR" -maxdepth 1 -type f \
        -name '*_R1_001_val_1.clean_1.fastq.gz' | sort
)

R1="${R1_FILES[$((SLURM_ARRAY_TASK_ID - 1))]}"

SAMPLE=$(basename "$R1" _R1_001_val_1.clean_1.fastq.gz)
R2="${INPUT_DIR}/${SAMPLE}_R2_001_val_2.clean_2.fastq.gz"

COMBINED="${OUTPUT_DIR}/combined_reads/${SAMPLE}_combined.fastq.gz"
SAMPLE_OUT="${OUTPUT_DIR}/results/${SAMPLE}"

mkdir -p "$SAMPLE_OUT"

# Concatenate paired-end FASTQ files
zcat "$R1" "$R2" | gzip -c > "$COMBINED"

# Run HUMAnN 4 with MetaPhlAn 4.1.1
humann \
    --input "$COMBINED" \
    --output "$SAMPLE_OUT" \
    --output-basename "$SAMPLE" \
    --nucleotide-database "$NUCLEOTIDE_DB" \
    --protein-database "$PROTEIN_DB" \
    --metaphlan "$METAPHLAN_BIN" \
    --metaphlan-options "-t rel_ab_w_read_stats --bowtie2db $BOWTIE2_DB --index $METAPHLAN_INDEX --offline --nproc ${SLURM_CPUS_PER_TASK}" \
    --threads "${SLURM_CPUS_PER_TASK}" \
    --remove-temp-output

rm -f "$COMBINED"
