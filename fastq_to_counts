set -euo pipefail

source /global/software/conda/miniforge3/etc/profile.d/conda.sh
conda activate metaphlan411_env

INPUT_DIR="/work/mccoy_lab/ramya_pd/larissa_gut_microbiota_WGS/hostile_cleaned_run_2"
OUTPUT_DIR="${INPUT_DIR}/metaphlan4_results"

DB_DIR="/work/mccoy_lab/ramya_pd/databases/metaphlan/vOct22"
INDEX="mpa_vOct22_CHOCOPhlAnSGB_202403"

mkdir -p "${OUTPUT_DIR}/profiles" "${OUTPUT_DIR}/bowtie2"

for R1 in "${INPUT_DIR}"/*_R1_001_val_1.clean_1.fastq.gz; do

    SAMPLE=$(basename "$R1" _R1_001_val_1.clean_1.fastq.gz)
    R2="${INPUT_DIR}/${SAMPLE}_R2_001_val_2.clean_2.fastq.gz"

    metaphlan "${R1},${R2}" \
        --input_type fastq \
        --bowtie2db "$DB_DIR" \
        --index "$INDEX" \
        --offline \
        --nproc "${SLURM_CPUS_PER_TASK}" \
        --bowtie2out "${OUTPUT_DIR}/bowtie2/${SAMPLE}.bowtie2.bz2" \
        -o "${OUTPUT_DIR}/profiles/${SAMPLE}_profile.tsv"

done
