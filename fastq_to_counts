#!/bin/bash
#SBATCH --error err_hostile
#SBATCH --output out_hostile
#SBATCH --job-name hostile
#SBATCH --nodes=1
#SBATCH --mem=300G
#SBATCH --cpus-per-task=12
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=ramya.balasubramania@ucalgary.ca
#SBATCH --partition=cpu2023
#SBATCH --time=5-00:00:00

module load conda/base
source $(conda info --base)/etc/profile.d/conda.sh
conda activate hostile_env

IN_DIR="/work/mccoy_lab/ramya_pd/larissa_gut_microbiota_WGS/trimmed_fastq_run_2"
OUT_DIR="/work/mccoy_lab/ramya_pd/larissa_gut_microbiota_WGS/hostile_cleaned_run_2"

mkdir -p "$OUT_DIR"

for r1 in "$IN_DIR"/*R1_001_val_1.fq.gz
do
    r2="${r1/R1_001_val_1.fq.gz/R2_001_val_2.fq.gz}"

    sample=$(basename "$r1" _R1_val_1.fq.gz)

    echo "Processing sample: $sample"
    echo "R1: $r1"
    echo "R2: $r2"


    hostile clean \
        --fastq1 "$r1" \
        --fastq2 "$r2" \
        --index human-t2t-hla-argos985 \
        --threads 12 \
        --output "$OUT_DIR" \
        --force \
        > "$OUT_DIR/${sample}_hostile.json"

    echo "Finished sample: $sample"
done
