#step 1: we will need to build the manifest file which will serve as the input for the grow.py script (to get community growth)
(micom_env) [ramya.balasubramania@arc metaphlan_results]$ cat makingspeciesinput.py
import pandas as pd

df = pd.read_csv(
    "merged_metaphlan_gtdb.tsv",
    sep="\t",
    skiprows=1
)

# Keep only rows ending at species level
species = df[
    df["clade_name"].str.match(
        r".*;g__[^;]+;s__[^;]+$",
        na=False
    )
].copy()

# Extract genus
species["genus"] = species["clade_name"].str.extract(
    r";g__([^;]+);s__"
)

# Extract species
species["species"] = species["clade_name"].str.extract(
    r";s__([^;]+)$"
)

# Wide -> long
micom = species.melt(
    id_vars=["clade_name", "genus", "species"],
    var_name="sample_id",
    value_name="abundance"
)

# Percent -> fraction
micom["abundance"] = (
    pd.to_numeric(
        micom["abundance"],
        errors="coerce"
    ) / 100
)

# Remove zero / NA
micom = micom[
    micom["abundance"].notna() &
    (micom["abundance"] > 0)
].copy()

# 0.1% cutoff
micom = micom[
    micom["abundance"] >= 0.001
].copy()

# Species-level MICOM ID
micom["id"] = micom["species"]

micom = micom[
    ["sample_id", "id", "genus", "species", "abundance"]
]

micom.to_csv(
    "micom_UHGG_GTDB_species.csv",
    index=False
)

print(micom.head())

print(
    "Duplicates:",
    micom.duplicated(
        ["sample_id", "id"]
    ).sum()
)

print(
    "Samples:",
    micom["sample_id"].nunique()
)

print(
    "Species:",
    micom["species"].nunique()
)

print(
    micom.groupby("sample_id")["abundance"]
    .sum()
    .describe()
)
