import pandas as pd
from micom.workflows import build


def main():

    taxonomy = pd.read_csv(
        "micom_UHGG_GTDB_species.csv"
    )

    print("Input table:")
    print(taxonomy.head())

    print("\nNumber of samples:")
    print(taxonomy["sample_id"].nunique())

    print("\nNumber of species:")
    print(taxonomy["species"].nunique())

    manifest = build(
        taxonomy=taxonomy,
        model_db="/work/mccoy_lab/ramya_pd/databases/micom/uhgg201_gtdb207_species_1.qza",
        out_folder="micom_UHGG_species_communities",
        cutoff=0.001,
        threads=1
    )

    manifest.to_csv(
        "micom_UHGG_species_manifest.csv",
        index=False
    )

    print("\nMICOM build completed.")
    print("\nManifest:")
    print(manifest)


if __name__ == "__main__":
    main()
