import pandas as pd
from micom.workflows import grow


def main():

    # Load MICOM manifest
    manifest = pd.read_csv(
        "elinav_micom_UHGG_genus_manifest.csv"
    )

    # Load gapseq gut medium
    gut = pd.read_csv(
        "/work/mccoy_lab/ramya_pd/software/gapseq/dat/media/gut.csv"
    )

    # Convert gapseq compound IDs to UHGG MICOM exchange IDs
    medium = pd.DataFrame({
        "reaction": "EX_" + gut["compounds"] + "_m",
        "flux": gut["maxFlux"]
    })

    medium.index = medium["reaction"]

    print(medium.head())

    # Run cooperative tradeoff growth
    results = grow(
        manifest,
        model_folder="elinav_micom_UHGG_genus_communities",
        medium=medium,
        tradeoff=0.5,strategy="pFBA",
        threads=8
    )

    # Save taxon growth rates
    results.growth_rates.to_csv(
        "micom_gut_growth_rates_pfba.csv",
        index=False
    )

    # Save metabolite exchange fluxes
    results.exchanges.to_csv(
        "micom_gut_exchanges_pfba.csv",
        index=False
    )

    # Save metabolite annotations
    results.annotations.to_csv(
        "micom_gut_annotations_pfba.csv",
        index=False
    )


if __name__ == "__main__":
    main()
