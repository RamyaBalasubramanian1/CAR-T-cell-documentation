from micom.workflows import load_results
from micom.interaction import interactions


def main():

    results = load_results(
        "micom_gut_results_pfba_elinav.zip"
    )

    taxa = (
        results.growth_rates["taxon"]
        .dropna()
        .unique()
    )

    failed = []

    print("Number of taxa:", len(taxa))

    for taxon in taxa:

        print("Testing:", taxon)

        try:
            x = interactions(
                results,
                taxa=[taxon],
                threads=1
            )

            print("  OK", x.shape)

        except Exception as e:

            print("  FAILED", repr(e))
            failed.append(taxon)

    print("\nFailed taxa:")
    for t in failed:
        print(t)


if __name__ == "__main__":
    main()
