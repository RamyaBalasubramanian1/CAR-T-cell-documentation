from micom.workflows import load_results
from micom.interaction import interactions, summarize_interactions


def main():

    results = load_results(
        "micom_gut_results_pfba_elinav.zip"
    )

    taxa = (
        results.growth_rates["taxon"]
        .dropna()
        .unique()
    )

    failed_taxa = [
        "Enterococcus_B",
        "Parabacteroides",
        "COE1",
        "Methanosphaera",
        "Aeromonas",
        "Methanomassiliicoccus_A",
        "CAG_307"
    ]

    taxa_keep = [
        t for t in taxa
        if t not in failed_taxa
    ]

    print("Total taxa:", len(taxa))
    print("Taxa retained:", len(taxa_keep))
    print("Taxa excluded:", len(failed_taxa))

    # Calculate interactions
    full = interactions(
        results,
        taxa=taxa_keep,
        threads=8
    )

    print(full.shape)
    print(full.head())

    # Save full metabolite-level interactions
    full.to_csv(
        "micom_all_interactions_pfba_elinav.csv",
        index=False
    )

    # Summarize focal-partner interactions
    summary = summarize_interactions(full)

    print(summary.shape)
    print(summary.head())

    summary.to_csv(
        "micom_interactions_summary_pfba_elinav.csv",
        index=False
    )


if __name__ == "__main__":
    main()
