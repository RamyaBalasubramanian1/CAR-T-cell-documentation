from micom.workflows import load_results
from micom.interaction import interactions, summarize_interactions


def main():

    results = load_results(
        "micom_gut_species_agora.zip"
    )

    taxa = (
        results.growth_rates["taxon"]
        .dropna()
        .unique()
    )

    failed_taxa = [
        "Alistipes_onderdonkii",
        "Eisenbergiella_tayi"
    ]

    taxa_keep = [
        t for t in taxa
        if t not in failed_taxa
    ]

    print("Total species:", len(taxa))
    print("Species retained:", len(taxa_keep))
    print("Species excluded:", len(failed_taxa))

    full = interactions(
        results,
        taxa=taxa_keep,
        threads=8
    )

    full.to_csv(
        "micom_all_interactions_pfba_species_agora.csv",
        index=False
    )

    summary = summarize_interactions(full)

    summary.to_csv(
        "micom_interactions_summary_pfba_species_agora.csv",
        index=False
    )

    print("\nFull interactions:", full.shape)
    print("Summary:", summary.shape)


if __name__ == "__main__":
    main()
